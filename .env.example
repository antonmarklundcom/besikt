# ---------------------------------------------------------------------------
# Rapportverket — environment variables
# Copy to .env for local dev. On Windows PowerShell, create .env with:
#   Set-Content -Encoding utf8 .env "DATABASE_URL=..."
# NEVER use `>` redirect — it writes UTF-16 and breaks dotenv.
# ---------------------------------------------------------------------------

# Neon.tech PostgreSQL, EU region (Frankfurt/Stockholm). Use the pooled URL for
# the app; a direct (non-pooled) URL is fine for local `prisma db push`.
DATABASE_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# NextAuth. Generate a secret locally with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
# Starts as the *.hostingersite.com URL, updated after custom domain mapping.
NEXTAUTH_URL="http://localhost:3000"

# Seed admin (rotate password after first login).
ADMIN_EMAIL="admin@entreprenadkonsulterna.se"
ADMIN_PASSWORD="change-me-strong"

# Resend outbound email (phase 5).
RESEND_API_KEY=""
MAIL_FROM="Entreprenadkonsulterna <noreply@entreprenadkonsulterna.se>"

# PDF conversion: OFF by default for GDPR. Options: none | ilovepdf | cloudconvert | gotenberg
PDF_PROVIDER="none"
CLOUDCONVERT_API_KEY=""
ILOVEPDF_PUBLIC_KEY=""
ILOVEPDF_SECRET_KEY=""
# Self-hosted Gotenberg (see README §5) — URL of your own instance (Cloud Run,
# a small VPS, …) and an optional shared secret if you've put a check for it
# in front of the container.
GOTENBERG_URL=""
GOTENBERG_SECRET=""

# Public intake webhook shared secret (X-Webhook-Secret header).
WEBHOOK_SECRET="change-me"

# File storage root (Hostinger persistent disk in prod).
STORAGE_DIR="./storage"
